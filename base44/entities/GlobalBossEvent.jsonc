{
  "name": "GlobalBossEvent",
  "type": "object",
  "properties": {
    "week_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "damage",
        "kill"
      ],
      "default": "damage"
    },
    "damage": {
      "type": "number"
    },
    "level": {
      "type": "number"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "week_id",
    "player_name",
    "event_type",
    "message"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}