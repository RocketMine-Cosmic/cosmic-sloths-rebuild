{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "wallet_address": {
      "type": "string",
      "description": "Linked OmenX wallet address (lowercased)"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "role"
  ]
}