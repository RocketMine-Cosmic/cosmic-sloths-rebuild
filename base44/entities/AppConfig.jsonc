{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "unique": true,
      "description": "Config key (e.g. 'staff_pct_per_wallet')"
    },
    "value": {
      "type": "object",
      "additionalProperties": true,
      "description": "Config value (free-form JSON)"
    },
    "updated_by": {
      "type": "string",
      "description": "Wallet address of the admin who last updated this config"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about why the value was changed"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}