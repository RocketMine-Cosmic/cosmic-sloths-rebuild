{
  "name": "SquadChampionsPayoutLog",
  "type": "object",
  "properties": {
    "period_id": {
      "type": "string",
      "description": "Season id, e.g. 2026-S5"
    },
    "wallet_address": {
      "type": "string",
      "description": "Recipient wallet (lowercase)"
    },
    "squad_id": {
      "type": "string"
    },
    "squad_name": {
      "type": "string"
    },
    "squad_tag": {
      "type": "string"
    },
    "squad_rank": {
      "type": "number",
      "description": "1, 2, or 3"
    },
    "amount": {
      "type": "number",
      "description": "OMENX amount paid to this member"
    },
    "tx_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "rolled_over"
      ],
      "default": "success"
    }
  },
  "required": [
    "period_id",
    "wallet_address",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}