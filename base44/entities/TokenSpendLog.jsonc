{
  "name": "TokenSpendLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "OmenX wallet address for fraud detection"
    },
    "amount": {
      "type": "number"
    },
    "sku_id": {
      "type": "string",
      "description": "SKU id that was purchased (e.g. stat-upgrade-permanent-lvl3)"
    },
    "grant_info": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot of the grant payload (type, tier, stat/weapon/talent/cosmetic ids, level)"
    },
    "week_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "excluded_from_pool": {
      "type": "boolean",
      "default": false,
      "description": "If true, this spend is logged for audit but NOT counted toward the TokenPool used for player/staff payouts. Used for admin/owner self-purchases so spending your own OMENX doesn't end up redistributed back to yourself + the player base."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique per on-chain charge \u2014 set by purchaseSku from the OmenX transaction id (preferred) or the idempotencyKey it sent. Used to dedup TokenSpendLog rows so client retries after a successful OmenX charge don't create phantom duplicate log rows that inflate TokenPool/payouts."
    }
  },
  "required": [
    "user_id",
    "player_name",
    "amount",
    "wallet_address",
    "week_id",
    "season_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}