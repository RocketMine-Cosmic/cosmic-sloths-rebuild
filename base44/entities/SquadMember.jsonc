{
  "name": "SquadMember",
  "type": "object",
  "properties": {
    "squad_id": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "Wallet address of the member"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "leader",
        "officer",
        "member"
      ],
      "default": "member",
      "description": "leader = full control. officer = can approve join requests and kick members. member = standard."
    },
    "last_payout_week": {
      "type": "string"
    },
    "last_daily_payout_date": {
      "type": "string"
    }
  },
  "required": [
    "squad_id",
    "wallet_address",
    "player_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}